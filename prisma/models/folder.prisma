model Folder {
    id             Int      @id @default(autoincrement())
    name           String
    ownerId        Int
    owner          User     @relation(fields: [ownerId], references: [id])
    parentFolderId Int?
    parentFolder   Folder?  @relation("Folder", fields: [parentFolderId], references: [id])
    files          File[]
    folders        Folder[] @relation("Folder")
}
