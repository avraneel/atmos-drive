model File {
    id             Int      @id @default(autoincrement())
    name           String
    size           Int
    url            String
    uploadTime     DateTime
    ownerId        Int
    owner          User     @relation(fields: [ownerId], references: [id])
    parentFolderId Int
    parentFolder   Folder   @relation(fields: [parentFolderId], references: [id])
}
