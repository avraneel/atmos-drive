model File {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id])
  userId          Int
  name            String
  parentFolder    Folder   @relation(fields: [paerentFolderId], references: [id])
  paerentFolderId Int
  path            String
  uploadTime      DateTime
}

model Folder {
  id           Int      @id @default(autoincrement())
  name         String
  creationTime DateTime
  files        File[]
}

model User {
  id       Int    @id @default(autoincrement())
  fullname String
  username String @unique
  password String
  files    File[]
}

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
