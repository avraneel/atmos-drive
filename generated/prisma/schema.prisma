model File {
  id             Int      @id @default(autoincrement())
  name           String
  size           Int
  uploadTime     DateTime
  ownerId        Int
  owner          User     @relation(fields: [ownerId], references: [id])
  parentFolderId Int
  parentFolder   Folder   @relation(fields: [parentFolderId], references: [id])
}

model Folder {
  id             Int      @id @default(autoincrement())
  name           String
  ownerId        Int
  owner          User     @relation(fields: [ownerId], references: [id])
  parentFolderId Int?
  parentFolder   Folder?  @relation("Folder", fields: [parentFolderId], references: [id])
  files          File[]
  folders        Folder[] @relation("Folder")
}

model User {
  id       Int      @id @default(autoincrement())
  fullname String
  username String   @unique
  password String
  files    File[]
  folders  Folder[]
}

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
