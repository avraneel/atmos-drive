<dialog id="create-folder" open>
  <h2>Create Folder</h2>
  <form action="" method="post">
    <div class="formItem">
      <label for="foldername">Folder Name</label>
      <input type="text" name="foldername" id="foldername" />
    </div>
    <button>Create</button>
    <button commandfor="create-folder" command="close">Close</button>
  </form>
</dialog>
