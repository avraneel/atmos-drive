<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>
  </head>
  <body>
    <%- include("partials/navbar") %>
    <main class="main">
        <%- include("partials/sidebar.ejs", { url: url }) %>
        <div class="content">
            <h1>Welcome, <%= username %></h1>
            <div class="fileList">
              <article class="item"><a href="<%= prevUrl %>">..</a></article>
              <% elements.forEach(element => { %>
                <article class="item">
                  <% if(element.type == "folder") { %>
                    <a href="<%= url %>/<%= element.name %>"><%= element.name %></a>
                      <form action="<%= url %>/delete-folder" method="post">
                        <input type="hidden" name="folderId" value="<%= element.id %>">
                        <button class="delete">Delete</button>
                      </form>
                  <% } else { %>
                    <%= element.name %>
                  <% }; %>
                  <% if(element.type == "file") { %>
                    <div class="buttonPanel">
                      <form action="<%= url %>/delete-file" method="post">
                        <input type="hidden" name="fileId" value="<%= element.id %>">
                        <button class="delete">Delete</button>
                      </form>
                      <form action="<%= url %>/info" method="post">
                        <input type="hidden" name="fileId" value="<%= element.id %>">
                        <button clas="info">Information</button>
                      </form>
                    </form>
                  <% }; %>
                </article>
              <% }); %>
            </div>
        </div>
    </main>
  </body>
</html>
