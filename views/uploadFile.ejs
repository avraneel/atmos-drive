<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Upload | Atmos Drive</title>
  </head>
  <body>
    <%- include("partials/navbar") %> 
    <main class="main">
      <% if(currentUser) { %> 
        <%- include("partials/sidebar.ejs") %>
        <div class="uploadContainer">
          <h2>Upload Files</h2>
          <form action="/user/<%= username %>/upload/file" method="post" enctype="multipart/form-data">
            <div class="formItem">
              <label for="file">Upload File</label>
              <input type="file" name="file" id="file" />
            </div>
            <button>Submit</button>
          </form>
        </div>
      <% } %>
    </main>
  </body>
</html>




