<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Folder | Atmos Drive</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include("partials/navbar") %> 
    <main class="main">
        <% if(currentUser) { %> 
            <%- include("partials/sidebar.ejs", {url: url}) %>
            <div>
                <h2>Create Folder</h2>
                <form action="<%= url %>/upload/folder" method="post">
                    <div class="formItem">
                        <label for="foldername">Folder Name</label>
                        <input type="text" name="foldername" id="foldername" required/>
                    </div>
                    <button>Submit</button>
                </form>
            </div>
        <% } %>
    </main>
</body>
</html>
