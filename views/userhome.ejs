<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>
  </head>
  <body>
    <%- include("partials/navbar") %>
    <main class="main">
        <%- include("partials/sidebar.ejs", { username: username }) %>
        <div class="content">
            <h1>Welcome, <%= username %></h1>
            <div class="fileList">
              <article><a href="">..</a></article>
              <% elements.forEach(element => { %>
                <article class="item">
                  <% if(element.type == "folder") { %>
                    <a href="<%= element.baseUrl %>/<%= element.name %>"><%= element.name %></a>
                    <form action="" method="post" class="buttonPanel">
                      <button>Delete</button>
                    </form>
                  <% } else { %>
                    <%= element.name %>
                  <% }; %>
                  <% if(element.type == "file") { %>
                    <form action="" method="post" class="buttonPanel">
                      <button>Delete</button>
                      <button>Information</button>
                    </form>
                  <% }; %>

                </article>
              <% }); %>
            </div>
        </div>
    </main>
  </body>
</html>
