<dialog class="createFolder">
  <h2>Create Folder</h2>
  <form action="/user/<%= username %>/upload/folder" method="post">
    <div class="formItem">
      <label for="foldername">Folder Name</label>
      <input type="text" name="foldername" id="foldername" />
    </div>
    <button>Submit</button>
    <button>Cancel</button>
  </form>
</dialog>
